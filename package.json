{
  "name": "@meng_long/dsh-mine-sweeper",
  "version": "0.1.2",
  "description": "扫雷浮层 / Minesweeper overlay for DeepSeek Harness — 在会话区左侧悬浮一块可拖动、可折叠、可自定义行列与雷数的扫雷盘，纯内存状态。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "dependencies": {},
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.2 <5",
    "@deepseek-ai/dsh": ">=0.1.5-rc.2 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "scripts": {
    "check": "node --check index.js && node --check client.js",
    "test": "node test/smoke.mjs"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "minesweeper",
    "game",
    "扫雷"
  ],
  "author": "Mailemailezhu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mailemailezhu/dsh-mine-sweeper.git"
  },
  "homepage": "https://github.com/Mailemailezhu/dsh-mine-sweeper#readme",
  "bugs": {
    "url": "https://github.com/Mailemailezhu/dsh-mine-sweeper/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT"
}
